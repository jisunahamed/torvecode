{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@torveai/cli",
  "version": "1.0.6",
  "type": "module",
  "license": "MIT",
  "bin": {
    "torve": "bin/torve.cjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "exports": {
    "./vite-host": "./dev/host.js",
    "./run": "./src/run/index.ts",
    "./server-process": "./src/server-process.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "pack:npm": "bun run script/pack-npm.ts",
    "build:node": "bun run script/build-node.ts",
    "dev": "bun run src/index.ts",
    "test": "bun test --timeout 30000 --only-failures",
    "typecheck": "tsgo -b"
  },
  "dependencies": {
    "@opencode-ai/pty": "0.2.0",
    "@opentui/core": "catalog:"
  },
  "devDependencies": {
    "@opencode/script": "workspace:*",
    "@opencode/protocol": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.12",
    "@ff-labs/fff-bin-darwin-arm64": "0.10.5",
    "@ff-labs/fff-bin-linux-arm64-gnu": "0.10.5",
    "@ff-labs/fff-bin-linux-x64-gnu": "0.10.5",
    "@ff-labs/fff-bin-win32-arm64": "0.10.5",
    "@ff-labs/fff-bin-win32-x64": "0.10.5",
    "@yuuang/ffi-rs-darwin-arm64": "1.3.2",
    "@yuuang/ffi-rs-linux-arm64-gnu": "1.3.2",
    "@yuuang/ffi-rs-linux-x64-gnu": "1.3.2",
    "@yuuang/ffi-rs-win32-arm64-msvc": "1.3.2",
    "@yuuang/ffi-rs-win32-x64-msvc": "1.3.2",
    "@parcel/watcher-darwin-arm64": "2.5.1",
    "@parcel/watcher-linux-arm64-glibc": "2.5.1",
    "@parcel/watcher-linux-x64-glibc": "2.5.1",
    "@parcel/watcher-win32-arm64": "2.5.1",
    "@parcel/watcher-win32-x64": "2.5.1",
    "solid-refresh": "0.6.3",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  },
  "description": "TorveCode — AI coding agent for the terminal by Torve AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/jisunahamed/torvecode"
  },
  "optionalDependencies": {
    "@torveai/cli-darwin-arm64": "1.0.6",
    "@torveai/cli-darwin-x64": "1.0.6",
    "@torveai/cli-linux-arm64": "1.0.6",
    "@torveai/cli-linux-x64": "1.0.6",
    "@torveai/cli-win32-arm64": "1.0.6",
    "@torveai/cli-win32-x64": "1.0.6"
  }
}
